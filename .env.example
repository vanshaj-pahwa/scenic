# TMDB (required)
REACT_APP_API_KEY=        # client, in development
TMDB_API_KEY=             # Pages Functions (detail render, sitemap, proxy)

# Streaming servers (movie and TV pairs, up to 16)
REACT_APP_MOVIE_SERVER1=
REACT_APP_TV_SERVER1=
# REACT_APP_MOVIE_SERVER2=
# REACT_APP_TV_SERVER2=
# ...repeat through REACT_APP_MOVIE_SERVER16 / REACT_APP_TV_SERVER16
# REACT_APP_SERVER8_DOMAINS=   # comma-separated hosts for Server 8
# REACT_APP_SERVER7_MIRRORS=   # comma-separated fallback hosts for Server 7

# Downloads (optional)
DOWNLOAD_BASE_URL=

# Ad-free player (Scenic+) — server-side extractor (lib/streamSource.js)
# Catalog host base URL; resolves a TMDB id to an HLS stream via slug + player ajax.
CATALOG_BASE=
# The catalog's admin-ajax "action" name used to resolve a player embed.
CATALOG_PLAYER_ACTION=

# Secondary ad-free source (lib/mirrorSource.js) — id-native embed host, tried as a
# fallback when the primary source fails to resolve or play.
MIRROR_BASE=

# Tertiary ad-free source (lib/relaySource.js) — id-native aggregator whose stream
# payload is decoded server-side. Base host, comma-separated provider routes
# (tried in order; coverage varies per title), the stream referer, and an
# optional id-native subtitle host are all env-driven. Providers may serve HLS
# or a direct MP4.
RELAY_BASE=
RELAY_PROVIDER=
RELAY_REFERER=
RELAY_SUB_BASE=

# HLS proxy origin. Should point at the standalone Worker, which keeps segment
# traffic off this deployment's 100k requests/day. Unset falls back to the
# same-origin Function at /api/hls-proxy, which works but spends this project's
# quota on video. No trailing slash.
PROXY_BASE=https://stream.scenicplus.workers.dev

# Subtitle fallback (OpenSubtitles) — used when the source ships no subtitle
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_UA=Scenic v1.0

# Set true to show Scenic+ in the player
REACT_APP_ADFREE_ENABLED=false
